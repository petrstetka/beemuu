{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-macos-community.cjs"
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "resources": {
      "../community/": "community/"
    },
    "macOS": {
